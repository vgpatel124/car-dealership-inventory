# Test-only environment. Jest loads this (see jest.setup.js / jest.global-setup.js)
# so the test suite runs against a SEPARATE SQLite file and never touches the
# real dev.db used by the dev server and UI.
#
# The test.db file is gitignored via `prisma/*.db` (same as dev.db). This file
# itself is committed so the isolated test setup is reproducible on a fresh clone
# — it contains no real secrets.

DATABASE_URL="file:./test.db"

# Dummy secret; tests only need a stable value to sign/verify JWTs.
JWT_SECRET="test-only-secret-not-used-in-production"

JWT_EXPIRES_IN="1d"
