# SQLite database file (relative to the prisma/ directory). Must be a real
# file on disk, never an in-memory database.
DATABASE_URL="file:./dev.db"

# Secret used to sign/verify JWTs. Generate a strong one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-hex-string"

# JWT lifetime (zeit/ms format, e.g. 1d, 12h, 30m)
JWT_EXPIRES_IN="1d"

# API port
PORT=4000
